# Template of a host description: copy it to hosts/<name>.env (single-thread
# runs) and hosts/<name>-full.env (multithreaded runs on the whole machine),
# set HOST to the file's name in each, and adapt the values. The scripts
# source the file in bash, and scripts/run.py reads its KEY=VALUE lines
# ($HOME and other variables are expanded). See hosts/zen5.env and
# hosts/zen5-full.env for the machine of the published results.

# The name of this file without .env.
HOST=myhost
# Where everything is built, run and stored: Geant4 sources, builds, the
# examples, and results/<HOST>/<run>/.
ROOT=$HOME/geant4-rng
# The Geant4 datasets (about 2 GB, downloaded by scripts/build-host.sh).
DATA=$HOME/geant4-rng/data
# Parallel build jobs.
JOBS=16

# Optional: a GCC outside the system paths; scripts/setup-host.sh then writes
# wrappers to $ROOT/bin that add an rpath to its libstdc++.
# GCC_PREFIX=/usr/local
# PATH=$HOME/geant4-rng/bin:$PATH
# export PATH

# Single-thread runs: one CPU per parallel slot, space-separated. One slot
# per last-level-cache domain (and never two hyperthreads of one core) keeps
# the slots from slowing each other; scripts/interference.sh checks it, and
# scripts/reproduce.sh runs the campaign sequentially on the first CPU if the
# check fails. A single CPU means sequential runs.
ST_CPUS="2 4 6 8"

# Multithreaded runs: the CPUs (taskset list) that the run uses; the number of
# worker threads is the number of CPUs. In the -full file, all cores
# (e.g. MT_CPUS="0-95").
MT_CPUS="0-7"

# Optional: event counts are those of workloads/workloads.json times these
# scales. scripts/reproduce.sh calibrates them for the host (about 60 s per
# single-thread run, 40 s per multithreaded run) and exports them, which
# overrides the values here.
# EVENT_SCALE_ST=1.0
# EVENT_SCALE_MT=1.0
