# The zen5 host (see zen5.env) for full-machine MT runs: 96 threads, all cores.
# Results go to results/zen5-full/<date>/ (their rows would collide with the
# 8-thread MT rows of results/zen5/). EVENT_SCALE_MT from the pilot
# (results/zen5-full/2026-11-23/calib: 10.5 s at 4): about 40 s per run.
HOST=zen5-full
ROOT=$HOME/geant4-rng
DATA=$HOME/geant4-rng/data
JOBS=96
GCC_PREFIX=/usr/local
PATH=$HOME/geant4-rng/bin:$PATH
export PATH
ST_CPUS="20"
MT_CPUS="0-95"
MT_THREADS=96
EVENT_SCALE_MT=15
