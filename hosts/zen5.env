# Bare-metal server: AMD EPYC 9R45 (Zen 5), 96 cores, SMT off,
# 12 L3 domains of 8 cores (CPUs 8k..8k+7, 32 MB each), performance governor,
# clock fixed at 4.5 GHz; Linux. Compiler: GCC 16.2.0 in /usr/local, used through
# the wrappers in $ROOT/bin (scripts/setup-host.sh), which add an rpath to its
# libstdc++ (the system one is GCC 11's).
HOST=zen5
ROOT=$HOME/geant4-rng
DATA=$HOME/geant4-rng/data
JOBS=96
GCC_PREFIX=/usr/local
PATH=$HOME/geant4-rng/bin:$PATH
export PATH
# Sequential ST runs use the first CPU (L3 domain 2); parallel slots use one
# core per L3 domain, never domain 0. MT: one whole L3 domain, as desktop's 8 P-cores.
ST_CPUS="20 12 28 36 44 52 60 68 76 84 92"
MT_CPUS="8,9,10,11,12,13,14,15"
MT_THREADS=8
# Parallel MT slots: one L3 domain each (domains 1-11).
MT_SLOT_CPUS="8-15 16-23 24-31 32-39 40-47 48-55 56-63 64-71 72-79 80-87 88-95"
# Event scales from the pilot (results/zen5/2026-11-23/calib: 11 s ST at 0.34,
# 10.8 s MT8 at 0.5): about 60 s per ST run, 40 s per MT run.
EVENT_SCALE_ST=1.8
EVENT_SCALE_MT=1.8
# Transparent huge pages: the published results use madvise.
THP=madvise
