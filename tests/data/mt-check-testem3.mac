# 20 events of 10 GeV e- in the ATLAS HEC-like TestEm3 calorimeter (see atlashec.mac).
/control/verbose 0
/run/verbose 1
/testem/det/setNbOfLayers 25
/testem/det/setNbOfAbsor  2
/testem/det/setAbsor 1 liquidArgon 0.85 cm
/testem/det/setAbsor 2 Copper      2.5 cm
/testem/det/setSizeYZ             17 cm
/testem/phys/addPhysics  emstandard_opt0
/run/setCut 0.7 mm
/run/initialize
/gun/particle e-
/gun/energy 10 GeV
/random/setSeeds 1 2
/run/beamOn 20
